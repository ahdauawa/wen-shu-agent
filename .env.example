# Copy to .env, replace the example key, and keep .env out of Git.
# Comma-separated keys act as separate demo users. No client-supplied user_id.
WENSHU_API_KEYS=replace-with-a-random-local-key
WENSHU_DB_PATH=data/wenshu.sqlite3
# offline: deterministic local demonstration; openai: your compatible model API.
WENSHU_MODEL_MODE=offline
WENSHU_LLM_BASE_URL=https://api.deepseek.com/v1
WENSHU_LLM_API_KEY=
WENSHU_LLM_MODEL=deepseek-chat
WENSHU_LLM_TIMEOUT=20
# lexical runs without model downloads. chroma requires pip install -e ".[rag]".
WENSHU_RETRIEVAL_MODE=lexical
WENSHU_KNOWLEDGE_SOURCE=documents
WENSHU_KNOWLEDGE_DIR=knowledge/zulip
WENSHU_CHUNK_SIZE=800
WENSHU_CHUNK_OVERLAP=100
WENSHU_EMBEDDING_MODEL=BAAI/bge-m3
WENSHU_EMBEDDING_CACHE_PATH=data/models
WENSHU_CHROMA_PATH=data/chroma
# lexical demo: 0.18. For the bundled BGE-M3 corpus, calibrated threshold: 0.58.
WENSHU_RETRIEVAL_THRESHOLD=0.18
WENSHU_INTENT_THRESHOLD=0.65
